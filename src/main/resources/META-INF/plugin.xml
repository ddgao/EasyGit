<idea-plugin>
    <id>com.github.easygit</id>
    <name>EasyGit</name>
    <vendor email="easygit@example.com" url="https://github.com/easygit">EasyGit Team</vendor>

    <description><![CDATA[
    <h2>EasyGit - Git 分支合并助手</h2>
    <p>专为微服务项目开发设计的 IntelliJ IDEA 插件，简化 Git 分支合并和 Tag 管理流程。</p>

    <h3>核心功能</h3>
    <ul>
        <li><b>分支合并（基于远端分支）</b>：将功能分支合并到 dev / test / main，目标使用远端分支</li>
        <li><b>一键合并</b>：一次操作依次合并到所有环境</li>
        <li><b>智能打 Tag（基于远端分支）</b>：Tag 基于配置的远端分支创建，支持正常版本、临时需求(-P)、Hotfix(-H) 三种类型</li>
        <li><b>批量操作</b>：支持同时选择多个 Git 仓库进行批量合并或打 Tag</li>
        <li><b>独立 Tag 名称</b>：每个仓库可设置不同的 Tag 名称，支持批量设置和重置</li>
        <li><b>操作历史</b>：记录每次操作的详细信息，方便追溯</li>
    </ul>

    <h3>使用方式</h3>
    <ul>
        <li><b>项目视图右键菜单（推荐）</b>：选中项目目录 → 右键 → EasyGit（支持多选批量操作）</li>
        <li><b>VCS 菜单</b>：VCS → EasyGit</li>
        <li><b>工具窗口</b>：底部 EasyGit 面板，自动加载项目中的 Git 仓库</li>
    </ul>

    <h3>配置</h3>
    <p>Settings → Tools → EasyGit，可配置：</p>
    <ul>
        <li>环境分支名称（dev / test / main）</li>
        <li>打 Tag 基准分支（默认 main）</li>
        <li>自动 Fetch / Push 选项</li>
    </ul>
    ]]></description>

    <!-- 依赖 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 通知组 -->
        <notificationGroup id="EasyGit.Notifications" displayType="BALLOON"/>

        <!-- 工具窗口 -->
        <toolWindow id="EasyGit"
                    anchor="bottom"
                    secondary="true"
                    icon="AllIcons.Vcs.Merge"
                    factoryClass="com.github.easygit.ui.EasyGitToolWindowFactory"/>

        <!-- 应用级配置持久化 -->
        <applicationService
                serviceImplementation="com.github.easygit.settings.EasyGitSettings"/>

        <!-- 项目级配置持久化 -->
        <projectService
                serviceImplementation="com.github.easygit.settings.EasyGitProjectSettings"/>

        <!-- 操作历史服务 -->
        <applicationService
                serviceImplementation="com.github.easygit.service.HistoryService"/>

        <!-- 分支清理服务 -->
        <projectService
                serviceImplementation="com.github.easygit.service.BranchCleanService"/>

        <!-- 设置页面 -->
        <applicationConfigurable
                parentId="tools"
                instance="com.github.easygit.settings.EasyGitConfigurable"
                id="com.github.easygit.settings"
                displayName="EasyGit"/>
    </extensions>

    <actions>
        <!-- ==================== 项目视图右键菜单（核心功能） ==================== -->
        <group id="EasyGit.ProjectViewPopup" text="EasyGit" popup="true"
               icon="AllIcons.Vcs.Merge">
            <!-- 添加到项目视图右键菜单，放在 Git 菜单之后 -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Git.Menu"/>

            <action id="EasyGit.ProjectView.MergeToDev"
                    class="com.github.easygit.actions.ProjectViewMergeToDevAction"
                    text="合并到 Dev"
                    description="将当前分支合并到 dev 分支"
                    icon="AllIcons.Vcs.Merge"/>

            <action id="EasyGit.ProjectView.MergeToTest"
                    class="com.github.easygit.actions.ProjectViewMergeToTestAction"
                    text="合并到 Test"
                    description="将当前分支合并到 test 分支"
                    icon="AllIcons.Vcs.Merge"/>

            <action id="EasyGit.ProjectView.MergeToMain"
                    class="com.github.easygit.actions.ProjectViewMergeToMainAction"
                    text="合并到 Main"
                    description="将当前分支合并到 main 分支"
                    icon="AllIcons.Vcs.Merge"/>

            <separator/>

            <action id="EasyGit.ProjectView.OneClickMerge"
                    class="com.github.easygit.actions.ProjectViewOneClickMergeAction"
                    text="一键合并所有环境"
                    description="依次合并到 dev、test、main"
                    icon="AllIcons.Actions.RunAll"/>

            <separator/>

            <action id="EasyGit.ProjectView.CreateTag"
                    class="com.github.easygit.actions.ProjectViewCreateTagAction"
                    text="打 Tag..."
                    description="打开对话框创建 Tag"
                    icon="AllIcons.Vcs.CommitNode"/>

            <separator/>

            <action id="EasyGit.ProjectView.CleanBranch"
                    class="com.github.easygit.actions.ProjectViewCleanBranchAction"
                    text="清理分支..."
                    description="智能清理过期分支"
                    icon="AllIcons.Actions.GC"/>
        </group>

        <!-- ==================== 主菜单组 ==================== -->
        <group id="EasyGit.MainMenu" text="EasyGit" popup="true">
            <add-to-group group-id="VcsGroups" anchor="last"/>

            <action id="EasyGit.MergeToDev"
                    class="com.github.easygit.actions.MergeToDevAction"
                    text="合并到 Dev"
                    description="将当前分支合并到 dev 分支"/>

            <action id="EasyGit.MergeToTest"
                    class="com.github.easygit.actions.MergeToTestAction"
                    text="合并到 Test"
                    description="将当前分支合并到 test 分支"/>

            <action id="EasyGit.MergeToMain"
                    class="com.github.easygit.actions.MergeToMainAction"
                    text="合并到 Main"
                    description="将当前分支合并到 main 分支"/>

            <separator/>

            <action id="EasyGit.OneClickMerge"
                    class="com.github.easygit.actions.OneClickMergeAction"
                    text="一键合并所有环境"
                    description="依次合并到 dev、test、main"/>

            <separator/>

            <action id="EasyGit.CreateTag"
                    class="com.github.easygit.actions.CreateTagAction"
                    text="打 Tag"
                    description="为选中的仓库创建 Tag"/>

            <separator/>

            <action id="EasyGit.BatchMerge"
                    class="com.github.easygit.actions.BatchMergeAction"
                    text="批量合并..."
                    description="批量合并多个仓库的分支"/>

            <action id="EasyGit.OpenToolWindow"
                    class="com.github.easygit.actions.OpenToolWindowAction"
                    text="打开 EasyGit 面板"
                    description="打开 EasyGit 工具窗口"/>

            <separator/>

            <action id="EasyGit.CleanBranch"
                    class="com.github.easygit.actions.CleanBranchAction"
                    text="清理分支..."
                    description="智能清理过期分支"/>
        </group>

    </actions>
</idea-plugin>
